# Copy to .env and fill in. Nothing in this file is a real value.

# Where the kernel writes. The application never carries a default that works
# in production; it reads this and only this.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kernel_dev

# Signs claim links. The kernel refuses to issue links while this is left at
# its development placeholder, because a placeholder that reaches production
# signs every link with a value anybody can read.
CLAIM_TOKEN_SECRET=replace-me-with-32-random-bytes

# How long a claim link stays usable. Seven days by default.
CLAIM_TOKEN_TTL_SECONDS=604800

# Upper bound on how many people one entitlement can be shared with. Mirrored
# by a check constraint in the schema, so changing it here alone does nothing.
ENTITLEMENT_SHARE_LIMIT=3
